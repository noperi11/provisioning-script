# Konfigurasi provisioning — salin ke .env lalu isi nilainya:
#   cp .env.example .env
# .env dibaca install.sh, diteruskan ke bootstrap-server.sh.
# Nilai boleh berisi spasi tanpa tanda kutip (penting untuk SSH public key).

DEPLOY_USER=deploy
SSH_PUBLIC_KEY=<PASTE_SSH_PUBLIC_KEY_ANDA>
NEW_HOSTNAME=<NAMA_HOST_BARU>
