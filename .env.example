# Provisioning config. Copy it to .env and fill in the values:
#   cp .env.example .env
# install.sh reads .env and passes the values on to bootstrap-server.sh.
# Values may contain spaces without quotes (this matters for the SSH public key).

DEPLOY_USER=deploy
SSH_PUBLIC_KEY=<PASTE_YOUR_SSH_PUBLIC_KEY>
NEW_HOSTNAME=<NEW_HOSTNAME>
