# Provisioning config — copy it to .env and fill in the values:
#   cp .env.example .env
# .env is read by install.sh and handed on to bootstrap-server.sh.
# Values may contain spaces without quotes (important for the SSH public key).

DEPLOY_USER=deploy
SSH_PUBLIC_KEY=<PASTE_YOUR_SSH_PUBLIC_KEY>
NEW_HOSTNAME=<NEW_HOSTNAME>
